# ========================================
# Database Configuration
# ========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=your_database_name

# ========================================
# JWT Secret
# ========================================
JWT_SECRET=your_jwt_secret_key_here

# ========================================
# Midtrans Configuration
# ========================================
# Sandbox Keys (untuk development)
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Production Keys (untuk production)
# MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxxxxxxxxxx
# MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxxxxxxxxxx
# MIDTRANS_IS_PRODUCTION=true

# ========================================
# Frontend Environment Variables (Vite)
# ========================================
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
VITE_MIDTRANS_IS_PRODUCTION=false

