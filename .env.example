# Salin jadi .env di VPS (/var/www/hdb-airconds/.env), isi nilai sebenarnya.
# JANGAN commit file .env asli ke git.

NODE_ENV=production
PORT=5000

# MariaDB lokal di VPS (satu instance dipakai bareng semua proyek, DB_NAME beda per proyek)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hdb_user
DB_PASSWORD=
DB_NAME=hdb_airconds

JWT_SECRET=

MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

ALLOWED_ORIGINS=https://hdbairconds.id,https://www.hdbairconds.id
SITE_URL=https://www.hdbairconds.id
BASE_URL=https://www.hdbairconds.id
