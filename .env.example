# ==========================================================================
# HDB AIRCONDS — Environment Variables
# ==========================================================================
# Copy file ini menjadi .env lalu isi dengan nilai aktual:
#   cp .env.example .env
#
# JANGAN COMMIT FILE .env KE GIT — sudah ada di .gitignore
# ==========================================================================


# ==========================================================================
# 1. APPLICATION
# ==========================================================================
NODE_ENV=development           # development | production
PORT=5000
SITE_URL=http://localhost:5000 # ganti ke https://www.hdbaircons.com saat production


# ==========================================================================
# 2. DATABASE (MySQL)
# ==========================================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=hdbaircons


# ==========================================================================
# 3. JWT — Authentication
# ==========================================================================
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# WAJIB ganti dengan string random panjang minimal 64 karakter saat production
JWT_SECRET=ganti_dengan_string_random_panjang_min_64_karakter


# ==========================================================================
# 4. MIDTRANS — Payment Gateway
# --------------------------------------------------------------------------
# PILIH SALAH SATU MODE (sandbox ATAU production), jangan keduanya aktif!
# ==========================================================================

# ----- MODE A: SANDBOX (development & testing) -----
# Server keys diawali "SB-Mid-server-..."
# Client keys diawali "SB-Mid-client-..."
# Dapatkan dari: https://dashboard.sandbox.midtrans.com → Settings → Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXX
MIDTRANS_IS_PRODUCTION=false

# ----- MODE B: PRODUCTION (siapkan saat go-live) -----
# UNCOMMENT 3 baris di bawah ini, COMMENT 3 baris sandbox di atas
# Server keys diawali "Mid-server-..." (TANPA prefix SB-)
# Client keys diawali "Mid-client-..." (TANPA prefix SB-)
# Dapatkan dari: https://dashboard.midtrans.com → Settings → Access Keys
# AKTIVASI PRODUCTION DULU di dashboard sebelum bisa dapat key ini!
#
# MIDTRANS_SERVER_KEY=Mid-server-XXXXXXXXXXXXXXXXXXXX
# MIDTRANS_CLIENT_KEY=Mid-client-XXXXXXXXXXXXXXXXXXXX
# MIDTRANS_IS_PRODUCTION=true


# ==========================================================================
# 5. FRONTEND (Vite) — dibaca oleh React saat build
# --------------------------------------------------------------------------
# HARUS SAMA dengan MIDTRANS_CLIENT_KEY di atas
# Setelah ubah nilai ini, WAJIB rebuild: npm run build
# ==========================================================================

# ----- Sandbox -----
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-XXXXXXXXXXXXXXXXXXXX
VITE_MIDTRANS_IS_PRODUCTION=false

# ----- Production (uncomment saat go-live, comment yang sandbox) -----
# VITE_MIDTRANS_CLIENT_KEY=Mid-client-XXXXXXXXXXXXXXXXXXXX
# VITE_MIDTRANS_IS_PRODUCTION=true


# ==========================================================================
# 6. CORS — Allowed Origins
# --------------------------------------------------------------------------
# Daftar domain yang boleh akses API (comma-separated, tanpa spasi)
# ==========================================================================

# Development (lokal)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Tambahkan IP LAN untuk testing dari HP/tablet (cari IP via `ipconfig`):
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://192.168.1.10:5173

# Production (uncomment saat go-live)
# ALLOWED_ORIGINS=https://hdbaircons.com,https://www.hdbaircons.com


# ==========================================================================
# CHECKLIST GO-PRODUCTION
# --------------------------------------------------------------------------
# Sebelum push ke server production, pastikan:
# [ ] NODE_ENV=production
# [ ] SITE_URL=https://www.hdbaircons.com
# [ ] JWT_SECRET sudah diganti dengan random 64+ char
# [ ] DB_PASSWORD pakai password yang kuat (bukan default)
# [ ] MIDTRANS_IS_PRODUCTION=true
# [ ] MIDTRANS_SERVER_KEY pakai "Mid-server-..." (BUKAN "SB-Mid-server-...")
# [ ] MIDTRANS_CLIENT_KEY pakai "Mid-client-..." (BUKAN "SB-Mid-client-...")
# [ ] VITE_MIDTRANS_* juga sudah production
# [ ] Jalankan `npm run build` ulang setelah ubah VITE_*
# [ ] ALLOWED_ORIGINS pakai HTTPS domain production
# [ ] Webhook URL sudah didaftarkan di Midtrans Dashboard:
#     https://www.hdbaircons.com/api/midtrans/webhook
# ==========================================================================
